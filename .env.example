# Copia este archivo a .env y ajusta tus valores.
BENCHMARK=IWDA.AS
APORTACION_PERIODICA=200
FRECUENCIA_APORTACION=mensual
INFLACION=espana
TEMA=auto
TASA_LIBRE_RIESGO=2

# Puerto del host para la web (http://localhost:8000).
PUERTO=8000

# UID/GID del usuario del host que será dueño de los informes generados.
# En Linux suele ser 1000:1000. Compruébalo con: id -u && id -g
UID=1000
GID=1000

# Protección opcional de la web con HTTP Basic.
# Si dejas las dos variables vacías, no se pide usuario ni contraseña.
# WEB_USUARIO=tu_usuario
# WEB_CLAVE=cambia-esta-clave

# Opcional y reservado para futuras versiones. La descarga de datos usa Yahoo
# Finance; este plan gratuito de Twelve Data no sirve series de fondos europeos.
# TWELVE_DATA_API_KEY=tu_clave
