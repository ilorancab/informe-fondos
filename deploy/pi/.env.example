# Copia este archivo a .env.
# Imagen publicada. Si haces fork, cambia por TU_USUARIO/informe-fondos.
IMAGE=ilbravo/informe-fondos:latest

# Puerto de la Raspberry donde se publica la web.
PUERTO=8000

# Usuario/grupo del host que será dueño de datos/ y salida/.
# Compruébalo en la Raspberry con: id -u && id -g
UID=1000
GID=1000

TZ=Europe/Madrid

# Valores por defecto del generador.
BENCHMARK=IWDA.AS
APORTACION_PERIODICA=200
FRECUENCIA_APORTACION=mensual
INFLACION=espana
TEMA=auto
TASA_LIBRE_RIESGO=2

# Protección opcional de la web. Si los dejas vacíos, no hay login.
# WEB_USUARIO=tu_usuario
# WEB_CLAVE=una-clave-larga

# Opcional y reservado para futuras versiones (Yahoo Finance es la fuente actual).
# TWELVE_DATA_API_KEY=tu_clave
